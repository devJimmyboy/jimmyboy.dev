// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  color    String @default("#55ff55")
  owner    String
  repo     String
  url      String
  category String @default("Projects")
  config   Json?

  @@id([owner, repo])
}

model Updates {
  id        Int      @id @default(autoincrement())
  owner     String
  timestamp DateTime @default(now())
}
